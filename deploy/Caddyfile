# Caddy interno: sirve la web estática y reparte /api y /mcp. El TLS lo termina el proxy del VPS
# (ver deploy/nginx-radio.guildawork.com.conf); este Caddy solo escucha en HTTP dentro de Docker.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		X-Frame-Options DENY
		-Server
	}

	# --- Públicas (no pasan por la puerta de acceso) ---
	# Inicio de sesión de la web y OAuth del MCP: las páginas llevan su propia CSP (el formulario de consentimiento redirige a la app del cliente).
	@acceso path /api/auth/* /api/oauth/*
	handle @acceso {
		reverse_proxy api:8000
	}
	# Metadatos OAuth (RFC 8414 / 9728): los pide el cliente MCP antes de autorizar.
	handle /.well-known/oauth-* {
		reverse_proxy api:8000
	}
	handle /api/health {
		reverse_proxy api:8000
	}
	# Descargas por enlace firmado que da el MCP (ADIF, respuestas grandes): el token caduca en una hora y solo sirve para ese fichero (ver descargas.py).
	handle /api/descargar/* {
		reverse_proxy api:8000
	}
	# Servidor MCP: valida su propio token (OAuth o MG_MCP_TOKEN) y anuncia dónde autenticarse.
	handle /mcp* {
		reverse_proxy mcp:8001
	}

	# --- Todo lo demás exige sesión de Guilda Work ---
	# forward_auth consulta /api/auth/check: sin sesión, las navegaciones van a /api/auth/login y el resto recibe 401.
	handle /api/* {
		forward_auth api:8000 {
			uri /api/auth/check
		}
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; child-src blob:; connect-src 'self' https://tile.openstreetmap.org; font-src 'self'; manifest-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		reverse_proxy api:8000
	}

	handle {
		forward_auth api:8000 {
			uri /api/auth/check
		}
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; child-src blob:; connect-src 'self' https://tile.openstreetmap.org; font-src 'self'; manifest-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		root * /srv/web
		# La app se actualiza con el service worker: html/js/css siempre se revalidan; fuentes, mapa e iconos se cachean.
		@assets path /fonts/* /vendor/* /icons/*
		header @assets Cache-Control "public, max-age=604800"
		@dyn not path /fonts/* /vendor/* /icons/*
		header @dyn Cache-Control "no-cache"
		file_server
	}
}
