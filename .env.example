# Clave de OpenRouter (https://openrouter.ai/keys). Sin ella se usa el resumen por reglas.
OPENROUTER_API_KEY=
# Opcional: lista fija de modelos separados por comas (si no, se descubren los gratuitos)
# MG_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
MG_DB=/data/meteoguilda.db
# Filtro APRS-IS (círculo lat/lon/km + paquetes meteo)
MG_APRS_FILTER=r/40.2/-3.7/700 t/w
