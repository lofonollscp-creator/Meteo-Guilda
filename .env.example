# --- Obligatorias ---
POSTGRES_PASSWORD=cambia-esto         # openssl rand -hex 24
MG_MCP_TOKEN=                         # token Bearer del MCP: openssl rand -hex 32
MG_ADMIN_TOKEN=                       # cabecera X-Admin-Token para tareas de administración (sincronizar repetidores, etc.)

# --- Opcionales ---
MG_HTTP_PORT=8088                     # puerto local (127.0.0.1) al que apunta el proxy del VPS
OPENROUTER_API_KEY=                   # sin ella se usa el resumen por reglas en lugar de la IA
# MG_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
# MG_VALHALLA_URL=https://valhalla1.openstreetmap.de   # instancia propia si el uso crece
MG_APRS_FILTER=                       # vacío = círculos de 60 km alrededor de los lugares de places.py
