# --- Obligatorias en producción ---
DOMAIN=localhost                 # dominio público (HTTPS automático). Pruebas sin dominio: :80
POSTGRES_PASSWORD=cambia-esto
MG_MCP_TOKEN=                    # token Bearer del MCP: openssl rand -hex 32
MG_ADMIN_TOKEN=                  # cabecera X-Admin-Token para importar repetidores por API

# --- IA ---
OPENROUTER_API_KEY=              # sin ella se usa el resumen por reglas
# MG_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# --- Opcionales ---
MG_APRS_FILTER=                  # vacío = círculos de 60 km alrededor de los lugares de places.py
# MG_VALHALLA_URL=https://valhalla1.openstreetmap.de   # instancia propia si el uso crece
